<script is:inline>
  (() => {
    const storedTheme = localStorage.getItem("theme");

    const initialTheme =
      storedTheme === "light" || storedTheme === "dark"
        ? storedTheme
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";

    document.documentElement.setAttribute("data-theme", initialTheme);
  })();
</script>
